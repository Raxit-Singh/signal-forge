# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (or legacy anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Public origin, used for auth redirect links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key, base64. Encrypts stored API keys / integration tokens (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Optional, for rotation: comma-separated "version:base64key" pairs of OLD keys
# still needed to decrypt existing rows. The current key is version CREDENTIALS_KEY_VERSION.
CREDENTIALS_KEY_VERSION=1
CREDENTIALS_PREVIOUS_KEYS=

# Shared secret for the scheduler → /api/jobs/tick call (Milestone 2).
JOBS_TICK_SECRET=

# --- Data sources (optional; see ENVIRONMENT_SETUP.md §3) ---------------------
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
YOUTUBE_API_KEY=

# --- Paid social data: API Direct (see ENVIRONMENT_SETUP.md §3b) ---------------
# SERVER ONLY. Paid calls also require PAID_SOURCES_ENABLED=true AND a global
# monthly budget row in api_budgets. Leave false during development.
API_DIRECT_API_KEY=
# TikHub (paid, per successful request): searches the listed platforms instead of API Direct.
# Any of x, tiktok, instagram. Comment fetching stays on API Direct. Leave empty to use API Direct only.
TIKHUB_API_KEY=
TIKHUB_PLATFORMS=
# Serper (paid, per query): Web and News search go through Serper instead of API Direct when set.
SERPER_API_KEY=
PAID_SOURCES_ENABLED=false

# --- Development only (inert in production builds and on Vercel) -------------
# Lets listed workspaces test faster Smart Monitoring intervals under `next dev`.
# Lowers only the plan's minimum interval (60/120/180/240/360/720); API budgets,
# paid allowances, rate limits and source minimums still apply.
DEV_MONITORING_MIN_INTERVAL_MINUTES=
DEV_MONITORING_WORKSPACES=

# --- SignalForge Intelligence (SYSTEM A; paid by SignalForge) ----------------
# See ENVIRONMENT_SETUP.md §3c. SERVER ONLY. Off unless ENABLED=true AND an operator
# row exists in public.ai_global_budget. Customers never supply AI keys for this.
SIGNALFORGE_AI_ENABLED=false
SIGNALFORGE_AI_PROVIDER=gemini
SIGNALFORGE_GEMINI_API_KEY=
# Model ids must be in src/lib/ai/pricing.ts (calls with unknown prices are refused).
# Cheapest current text model per ai.google.dev pricing (2026-10-16): gemini-3.1-flash-lite
SIGNALFORGE_AI_MODEL=
# Optional: on-demand analyses (defaults to SIGNALFORGE_AI_MODEL), e.g. gemini-3.8-flash
SIGNALFORGE_AI_DEEP_MODEL=
# Optional: semantic issue grouping (without it, word-based grouping): gemini-embedding-2
SIGNALFORGE_EMBEDDING_MODEL=

# --- Developer agent (SYSTEM B): GitHub App for customer repositories ------------
# See ENVIRONMENT_SETUP.md §3d. Read-only permissions; separate from GITHUB_TOKEN.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM with \n for newlines (one line).
GITHUB_APP_PRIVATE_KEY=

# SignalForge staff: comma-separated, verified account emails that may open /admin/costs
# (internal spend dashboard). Empty = nobody.
SIGNALFORGE_STAFF_EMAILS=

# Discord source (optional; see ENVIRONMENT_SETUP.md "Discord source"). SignalForge's own Discord application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Stripe (see ENVIRONMENT_SETUP.md "Stripe"). Test keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend; see ENVIRONMENT_SETUP.md "Email"). Without both, nothing is sent.
RESEND_API_KEY=
EMAIL_FROM=
