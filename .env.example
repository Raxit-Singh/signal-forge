# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (or legacy anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy service_role) key. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
# Public origin, used for auth redirect links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32-byte key, base64. Encrypts stored API keys / integration tokens (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Optional, for rotation: comma-separated "version:base64key" pairs of OLD keys
# still needed to decrypt existing rows. The current key is version CREDENTIALS_KEY_VERSION.
CREDENTIALS_KEY_VERSION=1
CREDENTIALS_PREVIOUS_KEYS=

# Shared secret for the scheduler → /api/jobs/tick call (Milestone 2).
JOBS_TICK_SECRET=

# --- Data sources (optional; see ENVIRONMENT_SETUP.md §3) ---------------------
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
YOUTUBE_API_KEY=

# --- Paid social data: API Direct (see ENVIRONMENT_SETUP.md §3b) ---------------
# SERVER ONLY. Paid calls also require PAID_SOURCES_ENABLED=true AND a global
# monthly budget row in api_budgets. Leave false during development.
API_DIRECT_API_KEY=
PAID_SOURCES_ENABLED=false

# --- Development only (inert in production builds and on Vercel) -------------
# Lets listed workspaces test faster Smart Monitoring intervals under `next dev`.
# Lowers only the plan's minimum interval (60/120/180/240/360/720); API budgets,
# paid allowances, rate limits and source minimums still apply.
DEV_MONITORING_MIN_INTERVAL_MINUTES=
DEV_MONITORING_WORKSPACES=
